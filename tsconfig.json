{
  "compilerOptions": {     /* Skip type checking all .d.ts files. */
    "target": "ES2015",
    "outDir": "./lib",
    "rootDir": "./src",
    "module": "commonjs",
    "lib": ["ES2015"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
